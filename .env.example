# .env.example  -  Variables de entorno del proyecto (#18)
# Copia estas claves en el panel de Railway (pestaña "Variables").
# En desarrollo local NO uses este archivo: usa config.local.php / db.local.php / mail.local.php.
# NUNCA subas valores reales a Git (este archivo solo tiene ejemplos).

# --- IA (Groq) ---------------------------------------------------------------
# API key de Groq (https://console.groq.com/keys). Obligatoria para el chat.
GROQ_API_KEY=gsk_tu_api_key_de_groq

# --- Base de datos (MySQL) ---------------------------------------------------
# En Railway, el plugin de MySQL provee estos valores; cópialos a estas variables.
DB_HOST=containers-us-west-xxx.railway.app
DB_NAME=railway
DB_USER=root
DB_PASS=tu_password_de_mysql

# --- Correo transaccional (recuperación / verificación, #15) ------------------
# EN RAILWAY usa BREVO (API HTTP): Gmail SMTP NO funciona en Railway porque
# bloquea los puertos SMTP (465/587). Brevo usa HTTPS (443), sí permitido.
# Crea la API key en https://app.brevo.com -> SMTP & API -> API Keys.
# MAIL_FROM debe ser un remitente VERIFICADO en Brevo (puede ser tu Gmail).
BREVO_API_KEY=xkeysib-tu_api_key_de_brevo
MAIL_FROM=tucorreo@gmail.com
MAIL_FROM_NAME=Estimador Copago

# Gmail SMTP (solo respaldo para desarrollo LOCAL; no funciona en Railway).
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=los16caracteres

# URL pública del sitio (para los enlaces de los correos). En Railway, tu dominio.
APP_URL=https://tu-app.up.railway.app

# --- Servidor ----------------------------------------------------------------
# Railway inyecta PORT automáticamente; el Dockerfile ya lo usa. No hace falta fijarla.
# PORT=8080
